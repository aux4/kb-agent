{
  "scope": "aux4",
  "name": "kb-agent",
  "version": "0.0.9",
  "description": "KB Q&A agent plugin for aux4/agent-manager \u2014 answers from the aux4 knowledge base",
  "dependencies": [
    "aux4/ai-agent"
  ],
  "tags": [
    "ai",
    "agent",
    "kb",
    "plugin"
  ],
  "profiles": [
    {
      "name": "agent-manager",
      "commands": [
        {
          "name": "kb",
          "execute": [
            "profile:agent-manager:kb"
          ],
          "help": {
            "text": "KB Q&A agent: answers questions from the aux4 knowledge base"
          }
        }
      ]
    },
    {
      "name": "agent-manager:kb",
      "commands": [
        {
          "name": "run",
          "execute": [
            "# MODEL auth: when --token is set, the caller's aux4 token is forwarded to the INFERENCE-BROKER via an ai-agent --model override (openai type, apiKey=token, broker baseURL) so model metering is attributed to the caller \u2014 lib/broker-model.mjs builds that JSON. TOOL auth is SEPARATE: the executeAux4 tool (aux4 cloud kb ...) runs through the api machine's warm daemon (aux4/api strips AUX4_NO_DAEMON for route-command children), so a per-request inline env does NOT reach it \u2014 the tool authenticates with the AGENT MACHINE's own identity via AUX4_ACCESS_TOKEN in the MACHINE env (the agent's per-scope m2m credential; SFA-054), which the daemon carries. AUX4_CLOUD_API_URL also comes from the machine env. When --token is empty, fall back to the configured model profile (config.yaml). NOTE: broker baseURL is dev-only for now; make it env-driven via AUX4_INFERENCE_URL before prod. [SFA]",
            "set:modelJson=!node ${packageDir}/lib/broker-model.mjs value(token)",
            "{ if(token!=) && aux4 ai agent ask --model value(modelJson) --instructions ${packageDir}/instructions.md --tools executeAux4 --permissions value(permissions) --policy value(policy) value(question); } || { if(token==) && aux4 ai agent ask --configFile ${packageDir}/config.yaml param(config) --instructions ${packageDir}/instructions.md --tools executeAux4 --permissions value(permissions) --policy value(policy) value(question); }"
          ],
          "help": {
            "text": "Answer a question using the aux4 knowledge base (called by 'agent-manager ask --agent kb')",
            "variables": [
              {
                "name": "question",
                "text": "The question to answer from the KB",
                "arg": true
              },
              {
                "name": "config",
                "text": "Model config section: cloud (inference-broker) or local (mlx)",
                "default": "cloud"
              },
              {
                "name": "token",
                "text": "Caller's aux4 bearer token (forwarded by agent-host ask-api). When set, the agent calls the inference-broker with this token instead of the configured model profile.",
                "default": ""
              },
              {
                "name": "permissions",
                "text": "Tool allow-list (cross-VM kb calls only)",
                "default": "{\"allow\":[\"aux4 cloud kb kb search\",\"aux4 cloud kb kb search *\",\"aux4 cloud kb kb view *\",\"aux4 cloud kb kb list\",\"aux4 cloud kb kb list *\"]}"
              },
              {
                "name": "policy",
                "text": "Guardrails (call budget)",
                "default": "{\"budget\":{\"calls\":15}}"
              }
            ]
          }
        },
        {
          "name": "describe",
          "execute": [
            "echo '{\"name\":\"kb\",\"description\":\"Answers questions from the aux4 knowledge base\",\"tools\":[\"cloud kb kb search\",\"cloud kb kb view\",\"cloud kb kb list\"]}'"
          ],
          "help": {
            "text": "Print this agent's metadata (name, description, tools)"
          }
        }
      ]
    }
  ]
}